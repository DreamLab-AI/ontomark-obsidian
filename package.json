{
  "name": "ontomark-obsidian",
  "version": "0.5.0",
  "private": true,
  "description": "Ontologies in Markdown for Obsidian: local index, reasoning, SPARQL and guarded frontmatter edits",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && tsc --noEmit -p . && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:wasm": "node --test test/wasm-harness.test.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs dist/main.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@dreamlab-ai/ontomark-graph": "https://github.com/DreamLab-AI/ontomark/releases/download/ontomark-graph-v0.3.0/dreamlab-ai-ontomark-graph-0.3.0.tgz",
    "@dreamlab-ai/vowl-wasm": "https://github.com/DreamLab-AI/vowl-wasm/releases/download/v0.2.3/vowl-wasm-0.2.3-pkg.tgz"
  }
}
